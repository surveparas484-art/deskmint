# Public production URL (no trailing slash). Used for canonical URLs, sitemap, robots.txt, and Open Graph.
# Set this in Vercel Environment Variables once deployed (e.g. https://deskmint.vercel.app or your custom domain).
NEXT_PUBLIC_SITE_URL=https://deskmint.vercel.app

# Optional: public contact email shown on the /contact page
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- AI Studio & Translation Studio (SERVER-SIDE ONLY) ----
OPENROUTER_API_KEY=
# Trusted non-Chinese free model example: google/gemini-2.0-flash-exp:free or meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_ALLOW_PAID=false

# Free visitor quota & burst protection per IP
AI_DAILY_FREE_LIMIT=3
AI_RATE_PER_MINUTE=6

# ---- Pro Upgrade Request Notifications (SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_) ----
# Put your receiving email here in .env.local and Vercel Environment Variables:
ADMIN_NOTIFY_EMAIL=surveparas484@gmail.com
# Recommended free email forwarding (get a free key at https://web3forms.com using your email):
WEB3FORMS_ACCESS_KEY=
# Optional alternative: Resend API key (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional SEO & Analytics integrations
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
